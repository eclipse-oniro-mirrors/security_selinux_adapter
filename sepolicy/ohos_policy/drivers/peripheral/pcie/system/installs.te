# avc: denied { create add_name write search getattr setattr } scontext=u:r:installs:s0 tcontext=u:object_r:pcie_driver_file:s0 tclass=dir permissive=1
allow installs pcie_driver_file:dir { create add_name write search getattr setattr };
# avc: denied { create write open read getattr setattr unlink rename } scontext=u:r:installs:s0 tcontext=u:object_r:pcie_driver_file:s0 tclass=file permissive=1
allow installs pcie_driver_file:file { create write open read getattr setattr unlink rename };
# avc: denied { ioctl } scontext=u:r:installs:s0 tcontext=u:object_r:pcie_driver_file:s0 tclass=file permissive=1 ioctlcmd=0x5413
allowxperm installs pcie_driver_file:file ioctl { 0x5413 };

# avc: denied { remove_name } scontext=u:r:installs:s0 tcontext=u:object_r:pcie_driver_file:s0 tclass=dir permissive=1
allow installs pcie_driver_file:dir { remove_name };

# avc: denied { ioctl } for pid=15366, comm="/system/bin/sa_main"  path="/dev/access_token_id" dev="" ino=4 ioctlcmd=0x5413 scontext=u:r:assessment_service:s0 tcontext=u:object_r:dev_at_file:s0 tclass=chr_file permissive=1
# From the earlier capture. The global allowx for dev_at_file only carries
# 0x4101/0x4103/0x4107, so 0x5413 must be granted per domain. The plain ioctl
# permission is globally covered, but the pair is kept as aimgr/acm and others do.
allow assessment_service dev_at_file:chr_file { ioctl };
allowxperm assessment_service dev_at_file:chr_file ioctl { 0x5413 };

# avc: denied { ioctl } for pid=9316, comm="/system/bin/sa_main"  path="/dev/binder" dev="" ino=13 ioctlcmd=0x62aa scontext=u:r:assessment_service:s0 tcontext=u:object_r:dev_binder_file:s0 tclass=chr_file permissive=0
# From the latest capture. The global rules only grant
# (allowx domain dev_binder_file (ioctl chr_file ((0x6201 0x6205 (range 0x6208
# 0x6209) (range 0x621e 0x6220) 0x62a1)))), coming from base/public/domain.te
# plus samgr/public/domain.te. 0x62aa is not among them, so it has to be
# granted per domain, as samgr and privacy_service already do for this command.
# The plain ioctl allow below is already covered by
# (allow domain dev_binder_file (chr_file (ioctl map open read write))) and a
# redundancy scan reports it as such; it is kept because an ioctl allow must be
# paired with its allowxperm, as privacy_service does and as the dev_at_file
# entry above does.
allow assessment_service dev_binder_file:chr_file { ioctl };
allowxperm assessment_service dev_binder_file:chr_file ioctl { 0x62aa };


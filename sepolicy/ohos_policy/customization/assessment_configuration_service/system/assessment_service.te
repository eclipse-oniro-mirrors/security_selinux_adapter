# AVCs show concrete hap types, but application policy uses attributes. The
# permission is system_basic level, so hap_domain would over-authorise.
# transfer: InvokeSystemDialog() connects the SceneBoard sysDialog extension and
# hands it the AssessmentAbilityConnection node created in this process.
allow assessment_service system_basic_hap_attr:binder { call transfer };
allow assessment_service system_core_hap_attr:binder { call transfer };


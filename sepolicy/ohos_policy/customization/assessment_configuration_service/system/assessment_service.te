# avc: denied { call } for pid=13767, comm="/system/bin/sa_main"  scontext=u:r:assessment_service:s0 tcontext=u:r:accessibility:s0 tclass=binder permissive=1
# avc: denied { transfer } for pid=13767, comm="/system/bin/sa_main"  scontext=u:r:assessment_service:s0 tcontext=u:r:accessibility:s0 tclass=binder permissive=1
allow assessment_service accessibility:binder { call transfer };

# avc: denied { map } for pid=13767, comm="/system/bin/sa_main"  path="/dev/__parameters__/u:object_r:arkcompiler_param:s0" dev="" ino=257 scontext=u:r:assessment_service:s0 tcontext=u:object_r:arkcompiler_param:s0 tclass=file permissive=1

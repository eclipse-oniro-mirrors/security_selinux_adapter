# avc: denied { call } for pid=13767, comm="/system/bin/sa_main"  scontext=u:r:assessment_service:s0 tcontext=u:r:system_core_hap:s0 tclass=binder permissive=1
# The AVC captured the concrete type system_core_hap, but application policy must use
# attributes rather than concrete types. ohos.permission.ASSESSMENT_CONFIGURATION is
# system_basic level, so only system_basic and system_core apps can hold it and thus
# be called back; granting hap_domain would over-authorise normal_hap / debug_hap.
# This mirrors the inbound rules in system/hap_domain.te.
allow assessment_service system_basic_hap_attr:binder { call };
allow assessment_service system_core_hap_attr:binder { call };


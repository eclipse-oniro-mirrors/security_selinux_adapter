# avc: denied { supervsable } for pid=13767, comm="/bin/init"  scontext=u:r:assessment_service:s0 tcontext=u:r:assessment_service:s0 tclass=hmcap permissive=1
# Skip: violates the neverallow in ohos_policy/kernel/linux/public/kernel.te, whose
# subject is {domain -hmcap_supervsable_common_attr -hmcap_supervsable_osr_attr ...}.
# assessment_service is a plain domain and is not a member of any
# hmcap_supervsable_* attribute, so granting this would fail the policy build.
# Being admitted to that attribute list is the kernel team's decision, not ours.
# allow assessment_service assessment_service:hmcap { supervsable };

# avc: denied { getopt } for pid=13767, comm="/system/bin/sa_main"  scontext=u:r:assessment_service:s0 tcontext=u:r:assessment_service:s0 tclass=unix_dgram_socket permissive=1
# avc: denied { setopt } for pid=13767, comm="/system/bin/sa_main"  scontext=u:r:assessment_service:s0 tcontext=u:r:assessment_service:s0 tclass=unix_dgram_socket permissive=1
allow assessment_service assessment_service:unix_dgram_socket { getopt setopt };

# avc:  denied  { set } for parameter=persist.assessment.is_active pid=13767 uid=1000 gid=1000 scontext=u:r:assessment_service:s0 tcontext=u:object_r:persist_param:s0 tclass=parameter_service permissive=1
# TODO(exam-mode): deferred to the follow-up change that introduces the
# assessment_writable_param label, which needs a platform memory registration
# because every parameter label gets its own shared memory file under
# /dev/__parameters__/ and a file occupies a whole page.
# The tcontext above reads persist_param because the capture device had no
# parameter_contexts entry for persist.assessment.*, so it fell back to the
# generic "persist." mapping. Do not "fix" that by granting set on persist_param:
# "persist." is a catch-all prefix, so such a rule would let this service write
# almost every persistent parameter in the system. All seven SetParameter call
# sites in assessment_service.cpp write only persist.assessment.is_active,
# .duration and .allowed_apps, so what they need is a dedicated label.
# Effect while deferred: under enforcing those writes are denied. SaveState() and
# ClearState() do not abort on failure, they only publish a SAVE_SYSPARAM_FAIL or
# RESET_SYSPARAM_FAIL trace event, so entering and exiting exam mode still work.
# Nothing reads the parameters back today either, the only reads sitting in
# LoadState(), which has no caller anywhere in the tree.
# Shape of the rule when it lands, with no file read for this domain unless
# LoadState() is wired up:
# allow assessment_service assessment_writable_param:parameter_service { set };

# avc: denied { map } for pid=13767, comm="/system/bin/sa_main"  path="/dev/__parameters__/u:object_r:debug_param:s0" dev="" ino=244 scontext=u:r:assessment_service:s0 tcontext=u:object_r:debug_param:s0 tclass=file permissive=1
# avc: denied { open } for pid=13767, comm="/system/bin/sa_main"  path="/dev/__parameters__/u:object_r:debug_param:s0" dev="" ino=244 scontext=u:r:assessment_service:s0 tcontext=u:object_r:debug_param:s0 tclass=file permissive=1
# avc: denied { read } for pid=13767, comm="/system/bin/sa_main"  path="/dev/__parameters__/u:object_r:debug_param:s0" dev="" ino=244 scontext=u:r:assessment_service:s0 tcontext=u:object_r:debug_param:s0 tclass=file permissive=1
allow assessment_service debug_param:file { map open read };

# avc: denied { ioctl } for pid=15366, comm="/system/bin/sa_main"  path="/dev/access_token_id" dev="" ino=4 ioctlcmd=0x5413 scontext=u:r:assessment_service:s0 tcontext=u:object_r:dev_at_file:s0 tclass=chr_file permissive=1
# AVC kept from the earlier capture. The global rule only grants
# (allowx domain dev_at_file (ioctl chr_file (0x4101 0x4103 0x4107))), so 0x5413
# has to be allowed per domain. It did not reappear in the latest capture because
# that device already ran a policy containing this rule; removing it would regress.
# The plain ioctl allow below is already covered by
# (allow domain dev_at_file (chr_file (ioctl read write open))) and a redundancy
# scan reports it as such; it is kept because every sibling domain that needs 0x5413
# writes the pair together (aimgr, acm, claw_sandbox_loader, medialibrary_hap).
allow assessment_service dev_at_file:chr_file { ioctl };
allowxperm assessment_service dev_at_file:chr_file ioctl { 0x5413 };

# avc: denied { open } for pid=13767, comm="/system/bin/sa_main"  path="/dev/kmsg" dev="" ino=28 scontext=u:r:assessment_service:s0 tcontext=u:object_r:dev_kmsg_file:s0 tclass=chr_file permissive=1

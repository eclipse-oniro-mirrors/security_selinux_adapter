allow assessment_service dev_unix_socket:dir { search };

# avc: denied { map } for pid=13767, comm="/system/bin/sa_main"  path="/dev/__parameters__/u:object_r:devinfo_type_param:s0" dev="" ino=287 scontext=u:r:assessment_service:s0 tcontext=u:object_r:devinfo_type_param:s0 tclass=file permissive=1
# avc: denied { open } for pid=13767, comm="/system/bin/sa_main"  path="/dev/__parameters__/u:object_r:devinfo_type_param:s0" dev="" ino=287 scontext=u:r:assessment_service:s0 tcontext=u:object_r:devinfo_type_param:s0 tclass=file permissive=1
# avc: denied { read } for pid=13767, comm="/system/bin/sa_main"  path="/dev/__parameters__/u:object_r:devinfo_type_param:s0" dev="" ino=287 scontext=u:r:assessment_service:s0 tcontext=u:object_r:devinfo_type_param:s0 tclass=file permissive=1
# No explicit allow here on purpose: assessment_service is admitted to
# devinfo_type_allow_attr in startup/init/public/parameter.te, and that same file
# already grants the attribute devinfo_type_param:file {open read map}, so repeating
# the allow here would be fully redundant.
# All three perms are required, not just read: the parameter area is mmap'd shared
# memory (/dev/__parameters__/<label>, see PARAM_STORAGE_PATH in
# init/services/param/include/param_utils.h), so GetParameter() needs open, map and
# read. The neverallow in that file prohibits exactly {open read map} for any sadomain
# outside the whitelist, hence whitelist admission is unavoidable and already minimal.
# Needed because AssessmentServiceUtils::GetDeviceType() reads const.product.devicetype
# both to decide whether this device is supported at all and to detect 2in1 (PC); if
# the read is denied under enforcing, GetParameter returns its empty default and exam
# mode becomes unavailable on every device, which permissive testing would not reveal.


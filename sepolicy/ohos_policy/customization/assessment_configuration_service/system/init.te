# avc: denied { rlimitinh } for pid=13767, comm="/system/bin/sa_main"  scontext=u:r:init:s0 tcontext=u:r:assessment_service:s0 tclass=process permissive=1
# avc: denied { siginh } for pid=13767, comm="/system/bin/sa_main"  scontext=u:r:init:s0 tcontext=u:r:assessment_service:s0 tclass=process permissive=1
# avc: denied { transition } for pid=13767, comm="/bin/init"  scontext=u:r:init:s0 tcontext=u:r:assessment_service:s0 tclass=process permissive=1
allow init assessment_service:process { rlimitinh siginh transition };

# TODO(exam-mode): the two rules the cfg param job needs are deferred with the
# assessment_writable_param label, which needs a platform memory registration (one
# page-sized shared memory file per label). init evaluates the job condition,
# expands ${persist.assessment.is_active}, then its command sets
# persist.assessment.is_examination_running, so it needs read and set:
#   allow init assessment_writable_param:file { map open read };
#   allow init assessment_writable_param:parameter_service { set };
# tmpfs associate and relabelto are already granted globally to parameter_attr. No
# domain-wide read: the CI check forbids a native attribute such as domain as
# subject or object. That job command is "ohsetprop", registered by a closed-source
# init module via AddCmdExecutor(), so it is not in the open-source command table.

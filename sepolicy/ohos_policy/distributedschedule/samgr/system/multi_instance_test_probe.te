debug_only(`
    type multi_instance_test_probe, sadomain, domain;

    allow multi_instance_test_probe bootevent_samgr_param:file { map open read };
    allow multi_instance_test_probe init_svc_param:file { map open read };
    allow multi_instance_test_probe startup_param:file { map open read };
    allow multi_instance_test_probe sys_param:file { map open read };
    allow multi_instance_test_probe sa_distributed_sched_test_audio:samgr_class { add get };
    allow init multi_instance_test_probe:process { rlimitinh siginh transition };
')

# 1. Register SA 403

# SAMGR: AddSystemAbilityInner selinux permission denied! SA:403,callSid:u:r:subfoundation:s0
allow subfoundation sa_form_mgr_service:samgr_class { add };

# 2. SA IPC permissions

# avc: denied { transfer } for pid=47286, comm="/system/bin/sa_main" scontext=u:r:subfoundation:s0 tcontext=u:r:accountmgr:s0 tclass=binder permissive=0
allow subfoundation accountmgr:binder { transfer };

# avc: denied { transfer } for pid=60170, comm="/system/bin/sa_main" scontext=u:r:subfoundation:s0 tcontext=u:r:accesstoken_service:s0 tclass=binder permissive=0
allow subfoundation accesstoken_service:binder { transfer };

# avc: denied { get } for service=1151 sid=u:r:subfoundation:s0 scontext=u:r:subfoundation:s0 tcontext=u:object_r:sa_net_conn_manager:s0 tclass=samgr_class permissive=0
allow subfoundation sa_net_conn_manager:samgr_class { get };
# avc: denied { call } for pid=60170, comm="/system/bin/sa_main" scontext=u:r:subfoundation:s0 tcontext=u:r:netmanager:s0 tclass=binder permissive=0
# avc: denied { transfer } for pid=1497, comm="/system/bin/sa_main" scontext=u:r:subfoundation:s0 tcontext=u:r:netmanager:s0 tclass=binder permissive=0
allow subfoundation netmanager:binder { call transfer };

# avc: denied { get } for service=1909 sid=u:r:subfoundation:s0 scontext=u:r:subfoundation:s0 tcontext=u:object_r:sa_memory_manager_service:s0 tclass=samgr_class permissive=0
allow subfoundation sa_memory_manager_service:samgr_class { get };
# avc: denied { call } for pid=55886, comm="/system/bin/sa_main" scontext=u:r:subfoundation:s0 tcontext=u:r:memmgrservice:s0 tclass=binder permissive=0
# avc: denied { transfer } for pid=1502, comm="/system/bin/sa_main" scontext=u:r:subfoundation:s0 tcontext=u:r:memmgrservice:s0 tclass=binder permissive=0
allow subfoundation memmgrservice:binder { call transfer };

# avc: denied { get } for service=1901 sid=u:r:subfoundation:s0 scontext=u:r:subfoundation:s0 tcontext=u:object_r:sa_resource_schedule:s0 tclass=samgr_class permissive=0
allow subfoundation sa_resource_schedule:samgr_class { get };

# avc: denied { get } for service=3901 sid=u:r:subfoundation:s0 scontext=u:r:subfoundation:s0 tcontext=u:object_r:sa_param_watcher:s0 tclass=samgr_class permissive=0
allow subfoundation sa_param_watcher:samgr_class { get };

# 3. File access (form_storage database)

# avc: denied { append } for pid=48005, comm="/system/bin/sa_main" path="/data/service/el1/public/database/form_storage/formdb.db-compare" scontext=u:r:subfoundation:s0 tcontext=u:object_r:data_service_el1_file:s0 tclass=file permissive=0
allow subfoundation data_service_el1_file:file { append };

# 4. System parameters

# Selinux check name resourceschedule.memmgr.min.memmory.watermark in u:object_r:resourceschedule_writeable_param:s0 failed
# avc: denied { read } for pid=1481, comm="/system/bin/sa_main"  path="/dev/__parameters__/u:object_r:resourceschedule_writeable_param:s0" dev="" ino=313 scontext=u:r:subfoundation:s0 tcontext=u:object_r:resourceschedule_writeable_param:s0 tclass=file permissive=0
# avc: denied { open } for pid=1484, comm="/system/bin/sa_main"  path="/dev/__parameters__/u:object_r:resourceschedule_writeable_param:s0" dev="" ino=313 scontext=u:r:subfoundation:s0 tcontext=u:object_r:resourceschedule_writeable_param:s0 tclass=file permissive=0
# avc: denied { map } for pid=1480, comm="/system/bin/sa_main"  path="/dev/__parameters__/u:object_r:resourceschedule_writeable_param:s0" dev="" ino=313 scontext=u:r:subfoundation:s0 tcontext=u:object_r:resourceschedule_writeable_param:s0 tclass=file permissive=0
allow subfoundation resourceschedule_writeable_param:file { read open map };
